# Copy to an ignored `.env.production` or the hosting secret store.

# Public HTTPS origin of this deployment
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN

# Dedicated production Supabase project. Never reuse DEV or STAGING credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Midtrans production pair. Sandbox credentials belong only to DEV/STAGING.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# RajaOngkir key already used in DEV. Set the warehouse destination ID.
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_COURIERS=jne:pos:tiki
SHIPPING_DEFAULT_WEIGHT_GRAMS_PER_METER=
SHIPPING_PACKAGING_WEIGHT_GRAMS=

CRON_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=store@example.test
EMAIL_ADMIN=admin@example.test

# Optional until an ERP receiver exists
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# Every Admin and Super Admin must enroll TOTP before production deployment.
ADMIN_MFA_REQUIRED=true
