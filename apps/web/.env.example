# Template only. Copy to an ignored local environment file and fill values through
# the approved secret store. Never paste production, staging, or personal values here.

# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=LOCAL_OR_DEPLOYMENT_PUBLISHABLE_KEY

# Server-only configuration
SUPABASE_SECRET_KEY=LOCAL_OR_DEPLOYMENT_SERVER_SECRET

# Payments: use sandbox values outside the approved production secret store.
MIDTRANS_SERVER_KEY=SANDBOX_OR_DEPLOYMENT_SERVER_KEY
MIDTRANS_CLIENT_KEY=SANDBOX_OR_DEPLOYMENT_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Shipping
RAJAONGKIR_API_KEY=LOCAL_OR_DEPLOYMENT_API_KEY
RAJAONGKIR_ORIGIN_ID=WAREHOUSE_ORIGIN_ID
RAJAONGKIR_COURIERS=jne:pos:tiki
SHIPPING_DEFAULT_WEIGHT_GRAMS_PER_METER=500
SHIPPING_PACKAGING_WEIGHT_GRAMS=500

# Email and internal jobs
SMTP_HOST=mail.example.test
SMTP_PORT=587
SMTP_USER=SMTP_USERNAME
SMTP_PASSWORD=SMTP_PASSWORD
EMAIL_PROVIDER_API_KEY=EMAIL_PROVIDER_API_KEY
EMAIL_FROM=store@example.test
EMAIL_ADMIN=admin@example.test
CRON_SECRET=GENERATE_A_UNIQUE_SECRET

# Optional ERP integration
ERP_WEBHOOK_URL=https://erp.example.test/webhook
ERP_WEBHOOK_SECRET=ERP_WEBHOOK_SECRET

# Privileged role policy
ADMIN_MFA_REQUIRED=true
